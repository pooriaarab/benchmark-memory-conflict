    "privacy",
    "booking-agent",
    "typescript"
  ],
  "homepage": "https://aibenchmarkindex.com/benchmarks/benchmark-memory-conflict",
  "bugs": "https://github.com/pooriaarab/benchmark-memory-conflict/issues",
  "repository": { "type": "git", "url": "git+https://github.com/pooriaarab/benchmark-memory-conflict.git" },
  "license": "MIT", "author": "Pooria Arab", "type": "module",
  "main": "./dist/index.js", "types": "./dist/index.d.ts",
